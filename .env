# ─────────────────────────────────────────────────────────────
# ABACUBIERTAS ERP API — Configuración de entorno (desarrollo)
# Copia este archivo a .env y ajusta los valores antes de
# desplegar en producción.
# ─────────────────────────────────────────────────────────────

# Fase de la aplicación: development | production
ENVIRONMENT=development

# Host/puerto donde escucha uvicorn dentro del contenedor
API_HOST=0.0.0.0
API_PORT=8000

# Prefijo de todas las rutas de la API
API_PREFIX=/api/v1

# ── Base de datos PostgreSQL ────────────────────────────────
# En producción apunta a tu instancia (ej: Aurora Serverless)
POSTGRES_DB=erpdatabase
POSTGRES_USER=erpdb
POSTGRES_PASSWORD=erpdev_secret_2025

# El host es "db" cuando corre dentro de docker compose.
# Fuera de docker usa localhost y el puerto mapeado.
DATABASE_URL=postgresql+psycopg2://erpdb:erpdev_secret_2025@db:5432/erpdatabase

# ── JWT ─────────────────────────────────────────────────────
# IMPORTANTE (producción): genera un secreto aleatorio de al menos 32 bytes:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production-use-a-random-32-bytes-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Si false, el endpoint /register queda deshabilitado (solo admin crea usuarios)
ALLOW_REGISTRATION=true

# ── CORS ────────────────────────────────────────────────────
# Orígenes permitidos separados por comas. En producción: tu dominio.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ── Usuario administrador bootstrap ─────────────────────────
# Se crea automáticamente en cada arranque si no existe.
ADMIN_USER_EMAIL=admin_user@abacubiertas.com
ADMIN_USER_PASSWORD=B7eRc5qsqKFnDU5HZubRoU1L