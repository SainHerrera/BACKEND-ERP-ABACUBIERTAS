# ─────────────────────────────────────────────────────────────
# ABACUBIERTAS ERP API — Plantilla de entorno (producción)
# 1. Copia a .env
# 2. Rellena los valores de producción
# 3. Reconstruye: docker compose up -d --build
# ─────────────────────────────────────────────────────────────

# Fase de la aplicación: development | production
# Con ENVIRONMENT=production la API se niega a arrancar si
# JWT_SECRET_KEY sigue siendo el valor por defecto.
ENVIRONMENT=production

# Host/puerto donde escucha uvicorn dentro del contenedor
API_HOST=0.0.0.0
API_PORT=8000

# Prefijo de todas las rutas de la API
API_PREFIX=/api/v1

# ── Base de datos PostgreSQL ────────────────────────────────
POSTGRES_DB=tu_database_name
POSTGRES_USER=tu_usuario
POSTGRES_PASSWORD=tu_password_seguro
DATABASE_URL=postgresql+psycopg2://<usuario>:<password>@<host>:<puerto>/<database>

# ── JWT ─────────────────────────────────────────────────────
# Genera un secreto aleatorio real (>= 32 bytes):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=RELLENA_CON_SECRETO_ALEATORIO
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# false si quieres deshabilitar el registro público
ALLOW_REGISTRATION=false

# ── CORS ────────────────────────────────────────────────────
# El dominio exacto de tu app frontend
CORS_ORIGINS=https://tu-dominio-app.com,https://abacubiertas-erp-frontend.vercel.app

# Origen permitido por regex (además de CORS_ORIGINS). Por defecto
# acepta cualquier deploy/preview de Vercel *.vercel.app.
# Déjala vacía (CORS_ORIGIN_REGEX=) para desactivar.
CORS_ORIGIN_REGEX=https://.+\.vercel\.app

# ── Usuario administrador bootstrap ─────────────────────────
# Se crea automáticamente en cada arranque si no existe.
# Cambia estas credenciales en producción.
ADMIN_EMAIL=admin_user@abacubiertas.com
ADMIN_PASSWORD=Cambia_esta_contrasena_en_produccion